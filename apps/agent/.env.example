SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# Browser origins allowed to call this API, comma-separated. Leave unset
# locally (defaults to http://localhost:3000). On Vercel, set it to the web
# project's URL, e.g. https://clockwork.vercel.app
ALLOWED_ORIGINS=

# Optional regex for origins that change per deploy, e.g. Vercel previews:
# ^https://clockwork-[a-z0-9-]+\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# Secret for POST /tasks/tick, which a schedule calls on serverless hosts
# (see .github/workflows/agent-tick.yml). Any long random string; set the
# same value as the CRON_SECRET GitHub repository secret. Not needed locally.
CRON_SECRET=
